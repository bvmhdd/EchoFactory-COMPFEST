# =====================================================================
# 🏭 EchoFactory — COMPFEST 18 AIC Production .gitignore
# =====================================================================

# Environment variables & Secret Keys
.env
.env.local
.env.*.local
.env*.local
*.env
!.env.example

# Large Model Files & Archives (store on HF Space or Google Drive, not GitHub)
Compfest Model/
*.rar
*.pt
*.pt_extracted/
*.onnx
*.onnx.data

# Node.js & Next.js Build Artifacts
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Jupyter Notebook Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Stale Training Notebooks & Iteration Artifacts
EchoFactory/fan/
EchoFactory/pump/
EchoFactory/slider/
EchoFactory/valve/
EchoFactory/Hasil Train V3/
EchoFactory/6dbechofac.ipynb
EchoFactory/train_*.ipynb
EchoFactory/NB-0*.ipynb
EchoFactory/hasil train/echofac1.ipynb
EchoFactory/hasil train/fanechofac[2-8].ipynb

# Binary Audio Assets (Auto-Generated at Runtime)
demo_samples/
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# Allow public preset samples for Vercel deployment
!public/samples/*.wav
!public/samples/**/*.wav

# Temporary PDF, OCR, and Document Scratch Files
*.pdf
[AIC]*
page_*.png
ocr_temp/
ocr.ps1
*ocr*.txt
*booklet*.txt
pdf_extracted.txt
*.docx
*.doc
*_BACKUP.*
~$*.docx
~$*.doc
scratch_diagrams/
compfest_space_repo/
proposal_figures/
!docs/storyboard/*.doc

# Scratch conversion & generation helper scripts
convert_*.py
create_docx.py
generate_*.py
update_*.py

# Ideation Drafts & Scratch Notes
SAVED_IDEA_*
PITCHDECK_AIC_*
IDEATION_GUIDE_*
Ideation Pitchdeck*
design.md
kineticgrid.md

# Operating System & IDE Cache
.DS_Store
Thumbs.db
.vscode/
.idea/
