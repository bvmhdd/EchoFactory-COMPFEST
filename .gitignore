# =====================================================================
# 🏭 EchoFactory — COMPFEST 18 AIC Production .gitignore
# =====================================================================

# Environment variables & Secret Keys
.env
.env.local
.env.*.local
.env*.local
*.env
!.env.example

# Large Model Files & Archives (store on HF Space or Google Drive, not GitHub)
Compfest Model/
*.rar
*.pt
*.pt_extracted/
*.onnx
*.onnx.data

# Node.js & Next.js Build Artifacts
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python & Jupyter Notebook Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Binary Audio Assets (Auto-Generated at Runtime)
demo_samples/
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# Temporary PDF, OCR, and Document Scratch Files
*.pdf
[AIC]*
page_*.png
ocr_temp/
ocr.ps1
*ocr*.txt
*booklet*.txt
pdf_extracted.txt
*.docx
~$*.docx
scratch_diagrams/
compfest_space_repo/

# Scratch conversion & generation helper scripts
convert_*.py
create_docx.py
generate_*.py
update_*.py

# Ideation Drafts & Scratch Notes
SAVED_IDEA_*
PITCHDECK_AIC_*
IDEATION_GUIDE_*
Ideation Pitchdeck*
design.md
kineticgrid.md

# Operating System & IDE Cache
.DS_Store
Thumbs.db
.vscode/
.idea/
