# ── Vercel Environment Variables ──────────────────────────────────────────────
# Set these at: vercel.com → [Project] → Settings → Environment Variables
#
# ── HF Space Backend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_HF_BACKEND_URL=https://bvmhd-compfest.hf.space

# ── Gemini API (server-side, NOT exposed to browser) ──────────────────────────
# Get from: aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Show Gemini Flash panel in dashboard UI (set to true to enable)
NEXT_PUBLIC_GEMINI_ENABLED=true

# ── Smart Contract (Polygon Amoy Testnet) ─────────────────────────────────────
NEXT_PUBLIC_CONTRACT_ADDRESS=0xFEc1FcFfF8E1C4B3470a677387F95bC3f1fD6864
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_NETWORK_NAME=Polygon Amoy Testnet

# ═════════════════════════════════════════════════════════════════════════════
# HF SPACE SECRETS (Terpisah dari Vercel — set di HF Space Settings)
# huggingface.co → [Space] → Settings → Variables and Secrets → New Secret
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY = [your key]   ← untuk cognitive_engine.py Python backend
