    .scene-table td {
        padding: 10px 14px;
        border-bottom: 1px solid #e2e8f0;
        vertical-align: top;
    }
    .vo-box {
        background: #ffffff;
        border-left: 4px solid #10b981;
        padding: 12px 16px;
        font-size: 14.5px;
        color: #0f172a;
        line-height: 1.8;
    }
