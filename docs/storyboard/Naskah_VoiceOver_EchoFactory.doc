        font-weight: 700;
        color: #1e3a8a;
    }
    .pause {
        color: #dc2626;
        font-weight: bold;
        font-size: 12px;
        background: #fee2e2;
        padding: 1px 6px;
        border-radius: 4px;
    }
    .sfx-tag {
        color: #d97706;
        font-family: monospace;
        font-weight: 600;
        font-size: 12px;
    }
    .ost-tag {
        color: #7c3aed;
        font-weight: 600;
        font-size: 12.5px;
    }
    .summary-table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0 30px 0;
        font-size: 13px;
    }
    .summary-table th, .summary-table td {
        border: 1px solid #cbd5e1;
        padding: 8px 12px;
        text-align: left;
    }
    .summary-table th {
        background: #0f294a;
        color: #ffffff;
    }
    .summary-table tr:nth-child(even) {
